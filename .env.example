# CAMION — variables de entorno del servidor (INF-2). SOLO NOMBRES: nunca pongas valores reales en este archivo ni en Git.
# En el equipo local se usa `dotnet user-secrets` (README §4). Detalle de cada clave: docs/GUIA-PUBLICACION.md §3.
# Cada ":" de la configuración de ASP.NET Core se escribe "__" en una variable de entorno.

# --- Entorno ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=

# --- Secretos (obligatorios) ---
ConnectionStrings__CamionDatabase=
Jwt__Key=

# --- Obligatorias fuera de Development (no secretas) ---
Media__Ruta=
DataProtection__RutaClaves=
Recuperacion__UrlPortal=

# --- Claves de DataProtection en Linux o contenedor (recomendadas) ---
DataProtection__Certificado__Ruta=
# Secreta:
DataProtection__Certificado__Clave=

# --- Proxy inverso (obligatorio si hay proxy delante) ---
Proxy__KnownProxies=
Proxy__KnownNetworks=
Proxy__ForwardLimit=

# --- Opcionales ---
Https__RedirigirHttp=
Portal__Origen=
AllowedHosts=
Recuperacion__LimiteVentana=
Recuperacion__VentanaMinutos=
Contactos__LimiteVentanaCorta=
Contactos__VentanaCortaMinutos=
Contactos__LimiteDiario=
Contactos__LimiteTelefonoDia=
PoliticaDatos__Version=
